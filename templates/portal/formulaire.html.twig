{% extends 'base.html.twig' %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="text-center mb-4">Configuration - Offre {{ offer|upper }}</h2>

                    {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.clientName, "Nom de l'entreprise (Sous-domaine)", {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.clientName, {'attr': {'class': 'form-control', 'placeholder': 'ex: ecole-michelet'}}) }}
                        <div class="form-text text-light-50 small">Accessible via https://<b>nom</b>.lutice.com.</div>
                        <div class="text-danger small">{{ form_errors(form.clientName) }}</div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.clientEmail, "Email administrateur", {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.clientEmail, {'attr': {'class': 'form-control', 'placeholder': 'admin@exemple.com'}}) }}
                        <div class="text-danger small">{{ form_errors(form.clientEmail) }}</div>
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.logoFile, "Logo de l'instance (Optionnel)", {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.logoFile, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    {# Les deux boutons d'action (Simulation ou Stripe) #}
                    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mt-4 border-top pt-4">
                        <button type="submit" name="payment_action" value="simulate" class="btn btn-outline-secondary btn-lg w-100">
                            ⚙️ Simuler sans payer
                        </button>

                        <button type="submit" name="payment_action" value="stripe" class="btn btn-primary btn-lg shadow w-100">
                            💳 Payer avec Stripe
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
